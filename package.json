{
  "name": "pg-queue",
  "version": "0.3.0",
  "description": "A PostgreSQL-backed background job queue with the node-resque runtime model",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=26"
  },
  "license": "Apache-2.0",
  "scripts": {
    "test": "bun test --max-concurrency=1",
    "test:node-package": "node scripts/assert-node-package.mjs",
    "build": "tsc && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
